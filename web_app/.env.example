# Copy this file to .env to get started; deploy platforms provide the real
# values as environment variables. Every variable is declared and validated
# in env.ts — server vars at boot (runtime process.env reads), VITE_-prefixed
# client vars at build time (baked into the bundle; never put secrets there).

# Signs the session cookie. Comma-separated, newest first: prepend a fresh
# secret to rotate ("new,old"), drop the old one after a week.
# Generate one:  openssl rand -base64 32
SESSION_SECRET=

# Rust API base URL (server-side only; the browser never calls it directly).
# API_SERVER_URL=http://127.0.0.1:5800/api/v1

# Public, baked into the client bundle at build time.
# VITE_APP_NAME=SIAKA
# VITE_INSTITUTION_CODE=
# VITE_CURRENT_INSTITUTION_ID=
