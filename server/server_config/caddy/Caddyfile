# The Caddyfile is an easy way to configure your Caddy web server.
#
# Unless the file starts with a global options block, the first
# uncommented line is always the address of your site.
#
# To use your own domain name (with automatic HTTPS), first make
# sure your domain's A/AAAA DNS records are properly pointed to
# this machine's public IP, then replace ":80" below with your
# domain name.

:80 {
	# Set this path to your site's directory.
	root * /usr/share/caddy

	# Enable the static file server.
	file_server

	# Another common task is to set up a reverse proxy:
	# reverse_proxy localhost:8080

	# Or serve a PHP site through php-fpm:
	# php_fastcgi localhost:9000
}

# Refer to the Caddy docs for more information:
# https://caddyserver.com/docs/caddyfile

siaka.tritunas.ac.id {
    root * /var/www/html/siaka_tritunas
    file_server

    # SPA fallback
    try_files {path} /index.html

    # Optional CORS (safe)
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers *
    }

    # Enable compression
    encode zstd gzip

    # Cache static assets aggressively (hashed files)
    @static {
        path_regexp static ^/assets/.*\.(js|css|png|jpg|jpeg|svg|gif|ico|webp|woff2?)$
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Cache HTML less aggressively
    @html {
        path *.html
    }
    header @html Cache-Control "no-cache"

    # Optional: force HTTPS
    # redir http://siaka.tritunas.ac.id https://siaka.tritunas.ac.id permanent
}

api.siaka.tritunas.ac.id {
    # CORS headers for your specific frontend
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, Accept"
        Access-Control-Allow-Credentials "true"
        # Optional: Handle preflight OPTIONS requests directly in Caddy
        defer
    }

    # Handle Preflight OPTIONS requests
    @options {
        method OPTIONS
    }
    respond @options 204

    # Reverse proxy to your Loco.rs app
    reverse_proxy localhost:5150 {
        # Pass the real client IP to the Rust app
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }
}

